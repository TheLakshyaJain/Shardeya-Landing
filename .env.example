# Postgres (consumed by docker-compose.yml and backend/src/main/resources/application.yml)
DB_NAME=shardeya
# Migration role — owns the schema, matches the Postgres bootstrap superuser.
DB_USER=shardeya
DB_PASSWORD=shardeya
# Runtime role — the app connects as this, NOT as DB_USER, so that Row-Level
# Security actually applies (Postgres exempts table owners and superusers from
# RLS). Created by V0_005__create_app_runtime_role.sql.
APP_DB_USER=shardeya_app
APP_DB_PASSWORD=shardeya_app
# BYPASSRLS role used only for the pre-auth mobile/email login lookup (mobile
# and email are global, not per-org, so this lookup can't know org_id yet).
# See V1_009__create_auth_lookup_role.sql.
AUTH_LOOKUP_DB_USER=shardeya_authlookup
AUTH_LOOKUP_DB_PASSWORD=shardeya_authlookup

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=shardeya
MINIO_ROOT_PASSWORD=shardeya123

# Backend
SERVER_PORT=8080
# Dev-only default — fine for local Docker Compose. Never reuse this value
# anywhere real; there's no production deployment story yet (out of scope
# until the full product is built, per project direction).
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production-change-me-32bytes+
